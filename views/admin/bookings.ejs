<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Admin - Customer Bookings</h2>
        <span class="badge bg-primary fs-6"><%= bookings.length %> booking(s)</span>
    </div>

    <% if (bookings.length === 0) { %>
        <div class="alert alert-info">
            No bookings have been made yet. Bookings will appear here once customers complete their checkout.
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Reference</th>
                        <th>Customer Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Tickets</th>
                        <th>Total</th>
                        <th>Booked On</th>
                    </tr>
                </thead>
                <tbody>
                    <% bookings.forEach(booking => { %>
                    <tr>
                        <td><%= booking.reference %></td>
                        <td><%= booking.customerName %></td>
                        <td><%= booking.email %></td>
                        <td><%= booking.phone %></td>
                        <td><%= booking.items.reduce((sum, item) => sum + item.quantity, 0) %> ticket(s)</td>
                        <td>SAR <%= booking.total.toFixed(2) %></td>
                        <td><%= new Date(booking.date).toLocaleDateString() %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>

    <a href="/" class="btn btn-outline-secondary mt-3">Back to Events</a>
</div>

<%- include('../partials/footer') %>
